"use client"
import { useEffect, useState } from "react"
import { useRouter } from "next/navigation"

export default function Dashboard() {
  const router = useRouter()
  const [user, setUser] = useState<any>(null)

  useEffect(() => {
    const stored = localStorage.getItem("user")
    if (!stored) {
      router.push("/login")
      return
    }
    setUser(JSON.parse(stored))
  }, [])

  const logout = () => {
    localStorage.removeItem("token")
    localStorage.removeItem("user")
    router.push("/login")
  }

  if (!user) return (
    <div style={{ background: "#0B1D3A", minHeight: "100vh",
      display: "flex", alignItems: "center", justifyContent: "center",
      color: "white", fontFamily: "sans-serif", fontSize: "18px" }}>
      Loading...
    </div>
  )

  return (
    <div style={{ background: "#0B1D3A", minHeight: "100vh",
      fontFamily: "sans-serif", color: "white", padding: "20px" }}>

      {/* Top bar */}
      <div style={{ display: "flex", justifyContent: "space-between",
        alignItems: "center", marginBottom: "32px",
        background: "#152B52", padding: "16px 20px",
        borderRadius: "14px", border: "1px solid #1D4ED8" }}>
        <div style={{ display: "flex", alignItems: "center", gap: 12 }}>
          <div style={{ fontSize: "32px" }}>🩺</div>
          <div>
            <div style={{ fontWeight: "800", fontSize: "18px",
              color: "#F59E0B" }}>MediLead</div>
            <div style={{ color: "#64748B", fontSize: "13px" }}>
              Welcome, {user.firstName}! 👋
            </div>
          </div>
        </div>
        <button onClick={logout} style={{
          background: "transparent", border: "1px solid #334155",
          color: "#94A3B8", padding: "8px 16px",
          borderRadius: "8px", cursor: "pointer",
          fontFamily: "sans-serif", fontSize: "13px"
        }}>
          Logout
        </button>
      </div>

      {/* Welcome card */}
      <div style={{ background: "#152B52", borderRadius: "16px",
        padding: "28px", border: "1px solid #1D4ED8",
        marginBottom: "20px", textAlign: "center" }}>
        <div style={{ fontSize: "48px", marginBottom: "12px" }}>🎉</div>
        <h2 style={{ fontSize: "22px", fontWeight: "800",
          color: "#F59E0B", marginBottom: "8px" }}>
          You're logged in!
        </h2>
        <p style={{ color: "#94A3B8", fontSize: "15px" }}>
          {user.email}
        </p>
        <p style={{ color: "#64748B", fontSize: "13px", marginTop: "8px" }}>
          Dashboard and exam features coming next
        </p>
      </div>

      {/* Stats placeholder */}
      <div style={{ display: "grid",
        gridTemplateColumns: "repeat(auto-fit, minmax(140px, 1fr))",
        gap: "12px" }}>
        {[
          { label: "Exams Taken", value: "0", icon: "📝" },
          { label: "Best Rank", value: "—", icon: "🏅" },
          { label: "Avg Score", value: "—", icon: "📊" },
          { label: "Streak", value: "0 🔥", icon: "⚡" },
        ].map(s => (
          <div key={s.label} style={{
            background: "#152B52", borderRadius: "12px",
            padding: "18px 14px", border: "1px solid #1E3A5F",
            textAlign: "center"
          }}>
            <div style={{ fontSize: "24px" }}>{s.icon}</div>
            <div style={{ fontSize: "22px", fontWeight: "800",
              color: "#F59E0B", margin: "6px 0 4px" }}>
              {s.value}
            </div>
            <div style={{ fontSize: "11px", color: "#64748B" }}>
              {s.label}
            </div>
          </div>
        ))}
      </div>

    </div>
  )
}